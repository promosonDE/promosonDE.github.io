# Copy this file to `.env.local` for local development, or set these variables
# in your hosting provider's build settings for production.
#
# Vite only exposes variables prefixed with VITE_ to the browser, so never put
# secrets here — this value is public by design.

# Formspree form ID — shown on your form's Integration tab as
# https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ID=
